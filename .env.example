# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (used in sign-in emails and notifications)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project settings → API keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (R2 → Manage API tokens, "Object Read & Write" on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=campus-xerox-uploads

# --- Razorpay (optional; online payment stays off without these) ------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Web Push (optional; "your prints are ready" notifications) -------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:shop@your-college.edu.in

# --- Scheduled clean-up (/api/cron/cleanup) ----------------------------------
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
